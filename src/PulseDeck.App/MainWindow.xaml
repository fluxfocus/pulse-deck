<Window x:Class="PulseDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PulseDeck.App.ViewModels"
        xmlns:controls="clr-namespace:PulseDeck.App.Controls"
        xmlns:conv="clr-namespace:PulseDeck.App.Converters"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Pulse Deck" Height="720" Width="1200">
    <Window.Resources>
        <conv:BoolToExpandGlyphConverter x:Key="ExpandGlyph"/>
        <conv:RgbColorToBrushConverter x:Key="RgbToBrush"/>
        <conv:LoadStatusToBrushConverter x:Key="LoadStatusBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <SolidColorBrush x:Key="MutedText" Color="#6E7580"/>

        <!-- Neither a Role-based Style trigger nor a local Foreground value had any effect on this
             ContextMenu's text — pixel-sampled a screenshot and confirmed the glyphs render almost
             exactly the popup's own background color regardless. That means the WPF Fluent theme's
             default MenuItem template must be painting the header text from its own theme resource,
             not from the Foreground property at all. This template sidesteps that entirely: it draws
             the header with a plain, hardcoded-color TextBlock that no theme resource can reach. -->
        <ControlTemplate x:Key="ReadableMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bg" Background="White" Padding="8,6,20,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="CheckMark" Grid.Column="0" Width="11" Height="9" Stretch="Uniform"
                          Data="M 1 5 L 4.5 8.5 L 11 1" Stroke="#1A1A1A" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Visibility="Collapsed" VerticalAlignment="Center"/>
                    <AccessText Grid.Column="1" Text="{TemplateBinding Header}" Foreground="#1A1A1A" FontSize="12"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#CDE8FA"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ReadableMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template" Value="{StaticResource ReadableMenuItemTemplate}"/>
        </Style>

        <ContextMenu x:Key="NameDisplayContextMenu">
            <MenuItem Header="Rename / Set Alias..." Style="{StaticResource ReadableMenuItemStyle}" Click="RenameSignal_Click"/>
            <Separator/>
            <MenuItem Header="Global default: Name + File" Style="{StaticResource ReadableMenuItemStyle}" Click="GlobalMode_OriginalWithFile_Click"/>
            <MenuItem Header="Global default: Name + File + Alias" Style="{StaticResource ReadableMenuItemStyle}" Click="GlobalMode_OriginalWithFileAndAlias_Click"/>
            <MenuItem Header="Global default: Alias only" Style="{StaticResource ReadableMenuItemStyle}" Click="GlobalMode_AliasOnly_Click"/>
            <Separator/>
            <MenuItem Header="This signal: Use global default" Style="{StaticResource ReadableMenuItemStyle}" Click="NodeMode_UseGlobal_Click"/>
            <MenuItem Header="This signal: Name + File" Style="{StaticResource ReadableMenuItemStyle}" Click="NodeMode_OriginalWithFile_Click"/>
            <MenuItem Header="This signal: Name + File + Alias" Style="{StaticResource ReadableMenuItemStyle}" Click="NodeMode_OriginalWithFileAndAlias_Click"/>
            <MenuItem Header="This signal: Alias only" Style="{StaticResource ReadableMenuItemStyle}" Click="NodeMode_AliasOnly_Click"/>
        </ContextMenu>

        <Style x:Key="RenameBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Node.IsMissing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupRow}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add VCD File(s)..." Command="{Binding AddFileCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <MenuItem Header="_Reload All" Command="{Binding ReloadAllCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="_Open Workspace..." Command="{Binding OpenWorkspaceCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <MenuItem Header="_Save Workspace" Command="{Binding SaveWorkspaceCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <MenuItem Header="Save Workspace _As..." Command="{Binding SaveWorkspaceAsCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" Style="{StaticResource ReadableMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _Fit" Command="{Binding ZoomFitCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="Auto-Reload on File Change" IsCheckable="True" IsChecked="{Binding AutoReloadEnabled}" Style="{StaticResource ReadableMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="Signal Aliases..." Click="OpenAliasEditor_Click" Style="{StaticResource ReadableMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" Style="{StaticResource ReadableMenuItemStyle}"/>
            </MenuItem>
        </Menu>

        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{StaticResource PanelBg}">
            <Button Content="Add VCD File(s)" Command="{Binding AddFileCommand}" Margin="4"/>
            <Button Content="Reload All" Command="{Binding ReloadAllCommand}" Margin="4"/>
            <Button Content="Signal Aliases..." Click="OpenAliasEditor_Click" Margin="4"/>
            <Separator Margin="4"/>
            <Button Content="Zoom Fit" Command="{Binding ZoomFitCommand}" Margin="4"/>
            <Button Content="Zoom In" Command="{Binding ZoomInCommand}" Margin="4"/>
            <Button Content="Zoom Out" Command="{Binding ZoomOutCommand}" Margin="4"/>
            <Separator Margin="4"/>
            <CheckBox Content="Auto-reload on file change" IsChecked="{Binding AutoReloadEnabled}"
                      VerticalAlignment="Center" Margin="6,0"/>
            <Separator Margin="4"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource TextSecondary}"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="140" VerticalAlignment="Center"
                     ToolTip="Filter signals by name across all loaded files"/>
            <Separator Margin="4"/>
            <TextBlock Text="Names:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="{StaticResource TextSecondary}"/>
            <Button Content="Name + File" Margin="2,0" Click="NamesGlobal_OriginalWithFile_Click"
                    ToolTip="Default for signals with no per-signal override (right-click a name to set one)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GlobalNameDisplayMode}" Value="OriginalWithFile">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Name + File + Alias" Margin="2,0" Click="NamesGlobal_OriginalWithFileAndAlias_Click"
                    ToolTip="Default for signals with no per-signal override (right-click a name to set one)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GlobalNameDisplayMode}" Value="OriginalWithFileAndAlias">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Alias Only" Margin="2,0" Click="NamesGlobal_AliasOnly_Click"
                    ToolTip="Default for signals with no per-signal override (right-click a name to set one)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GlobalNameDisplayMode}" Value="AliasOnly">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Separator Margin="4"/>
            <TextBlock Text="Ruler:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="{StaticResource TextSecondary}"/>
            <Button Content="A-" Width="26" Margin="2,0" Click="RulerFontDown_Click" ToolTip="Smaller timestamp text"/>
            <Button Content="A+" Width="26" Margin="2,0" Click="RulerFontUp_Click" ToolTip="Larger timestamp text"/>
            <CheckBox Content="Vertical labels" IsChecked="{Binding RulerTextVertical}" VerticalAlignment="Center" Margin="8,0"/>
            <CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="8,0"/>
            <Separator Margin="4"/>
            <TextBlock Text="Markup:" VerticalAlignment="Center" Margin="4,0,2,0" Foreground="{StaticResource TextSecondary}"/>
            <Button Content="Select" Margin="2,0" Click="ToolSelect_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Select">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="V-Line" Margin="2,0" Click="ToolVLine_Click" ToolTip="Click the waveform to drop a vertical time marker">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="VerticalLine">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Text" Margin="2,0" Click="ToolText_Click" ToolTip="Click the waveform to add a text note">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Text">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Arrow" Margin="2,0" Click="ToolArrow_Click" ToolTip="Drag between two points to measure/label the gap">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Arrow">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Clear Markups" Margin="8,0,2,0" Click="ClearMarkups_Click"/>
        </WrapPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Session.Files}" Background="{StaticResource PanelBgAlt}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush1}"
                            BorderThickness="1" CornerRadius="4" Margin="4" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Fill="{Binding Status, Converter={StaticResource LoadStatusBrush}}"/>
                            <TextBox Text="{Binding FileAlias, Mode=OneWay}" Width="100" Background="Transparent"
                                     BorderThickness="0" ToolTip="{Binding FilePath}" LostFocus="FileAliasBox_LostFocus"/>
                            <Button Content="&#x21BB;" ToolTip="Reload this file" Style="{StaticResource IconButtonStyle}"
                                    Click="ReloadFile_Click" Margin="4,0,0,0"/>
                            <Button Content="&#x2715;" ToolTip="Remove this file" Style="{StaticResource IconButtonStyle}"
                                    Click="RemoveFile_Click" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBgAlt}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Cursor: {0:0.000e+0} s   Window: {1:0.000e+0} s - {2:0.000e+0} s">
                            <Binding Path="CursorSeconds"/>
                            <Binding Path="WindowStartSeconds"/>
                            <Binding Path="WindowEndSeconds"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Signal browser: full file/scope hierarchy. Scrolls independently — it is purely for
                 finding and checking/unchecking/aliasing/coloring signals, not for the wave layout. -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgAlt}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Height="{Binding RulerHeight}" Background="#1A1C20" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Signals" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WaveRow}">
                                    <Grid Height="{x:Static vm:MainViewModel.RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="{Binding IndentWidth}"/>

                                        <Button Grid.Column="1" Content="{Binding Node.IsExpanded, Converter={StaticResource ExpandGlyph}}"
                                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource IconButtonStyle}" Click="ExpandToggle_Click"/>

                                        <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                                  IsChecked="{Binding Node.IsVisible}"
                                                  Visibility="{Binding IsSignalRow, Converter={StaticResource BoolToVis}}"/>

                                        <Border Grid.Column="3" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Background="{Binding Node.Color, Converter={StaticResource RgbToBrush}}"
                                                Visibility="{Binding IsSignalRow, Converter={StaticResource BoolToVis}}"
                                                MouseLeftButtonDown="ColorSwatch_Click" Cursor="Hand"/>

                                        <Grid Grid.Column="4">
                                            <TextBox Style="{StaticResource RenameBoxStyle}"
                                                     Text="{Binding Node.EditableName, Mode=OneWay}"
                                                     Visibility="{Binding IsGroupRow, Converter={StaticResource BoolToVis}}"
                                                     LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>

                                            <Grid Visibility="{Binding IsSignalRow, Converter={StaticResource BoolToVis}}"
                                                  ContextMenu="{StaticResource NameDisplayContextMenu}"
                                                  ContextMenuOpening="NameArea_ContextMenuOpening">
                                                <TextBox Style="{StaticResource RenameBoxStyle}"
                                                         Text="{Binding Node.EditableName, Mode=OneWay}"
                                                         Visibility="{Binding Node.IsAliasEditableInline, Converter={StaticResource BoolToVis}}"
                                                         ContextMenu="{StaticResource NameDisplayContextMenu}"
                                                         ContextMenuOpening="NameArea_ContextMenuOpening"
                                                         LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding Node.IsAliasEditableInline, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="{Binding Node.PrimaryNameText}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Node.IsMissing}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Node.AliasSuffixText, StringFormat='→ {0}'}" Margin="5,0,0,0"
                                                               FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding Node.ShowAliasSuffix, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Node.FileSuffixText, StringFormat='· {0}'}" Margin="5,0,0,0"
                                                               FontSize="9" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                                                               Visibility="{Binding Node.ShowFileSuffix, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <TextBlock Grid.Column="5" Text="NEW" FontSize="9" Margin="2,0,6,0" VerticalAlignment="Center"
                                                   Foreground="#81C784" Visibility="{Binding Node.IsNew, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Display order, waveform canvas, and values share one vertical scroll so their rows
                 always line up — all three are driven by the same flat FilteredDisplayList. The
                 horizontal scrollbar/pan-button row below is OUTSIDE that scroll, so it stays fixed
                 at the bottom of the viewport regardless of vertical scroll position. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBgAlt}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <Border Height="{Binding RulerHeight}" Background="#1A1C20" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Displayed (drag order)" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FilteredDisplayList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{x:Static vm:MainViewModel.RowHeight}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#x25B2;" Width="19" Height="22" FontSize="13" Padding="0"
                                                        Style="{StaticResource IconButtonStyle}" Click="MoveUp_Click" ToolTip="Move up"/>
                                                <Button Content="&#x25BC;" Width="19" Height="22" FontSize="13" Padding="0"
                                                        Style="{StaticResource IconButtonStyle}" Click="MoveDown_Click" ToolTip="Move down"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{Binding Color, Converter={StaticResource RgbToBrush}}"
                                                    MouseLeftButtonDown="ColorSwatch2_Click" Cursor="Hand"/>

                                            <Grid Grid.Column="2" ContextMenu="{StaticResource NameDisplayContextMenu}"
                                                  ContextMenuOpening="NameArea_ContextMenuOpening">
                                                <TextBox Style="{StaticResource RenameBoxStyle}"
                                                         Text="{Binding EditableName, Mode=OneWay}"
                                                         Visibility="{Binding IsAliasEditableInline, Converter={StaticResource BoolToVis}}"
                                                         ContextMenu="{StaticResource NameDisplayContextMenu}"
                                                         ContextMenuOpening="NameArea_ContextMenuOpening"
                                                         LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsAliasEditableInline, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="{Binding PrimaryNameText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding AliasSuffixText, StringFormat='→ {0}'}" Margin="5,0,0,0"
                                                               FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowAliasSuffix, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding FileSuffixText, StringFormat='· {0}'}" Margin="5,0,0,0"
                                                               FontSize="9" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowFileSuffix, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource IconButtonStyle}"
                                                    Click="RemoveFromDisplay_Click" ToolTip="Hide from waveform display"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource PanelBg}">
                        <controls:WaveformCanvas Rows="{Binding FilteredDisplayList}" Annotations="{Binding Annotations}"
                                                  WindowStartSeconds="{Binding WindowStartSeconds, Mode=TwoWay}"
                                                  WindowEndSeconds="{Binding WindowEndSeconds, Mode=TwoWay}"
                                                  CursorSeconds="{Binding CursorSeconds, Mode=TwoWay}"
                                                  RulerHeight="{Binding RulerHeight}" RulerFontSize="{Binding RulerFontSize}"
                                                  RulerTextVertical="{Binding RulerTextVertical}" ShowGrid="{Binding ShowGrid}"
                                                  ActiveTool="{Binding ActiveTool}" MaxWindowSpanSeconds="{Binding MaxWindowSpanSeconds}"
                                                  VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBgAlt}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1,0,0,0">
                        <controls:ValuesPanel Rows="{Binding FilteredDisplayList}" CursorSeconds="{Binding CursorSeconds}"
                                              RulerHeight="{Binding RulerHeight}" VerticalAlignment="Top"/>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Fine-pan controls: two buttons each side of the scrollbar (1/4 and 3/4 of the current
                 screen width) so a small nudge doesn't require a scrollbar-thumb drag, which can jump
                 a large distance at high zoom. Aligned under the waveform column specifically. -->
            <Grid Grid.Row="1" Background="{StaticResource PanelBgAlt}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" Margin="6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="&#x25C4;&#x25C4;" Width="32" Padding="0" Click="PanFarLeft_Click"
                            ToolTip="Pan left 3/4 screen"/>
                    <Button Grid.Column="1" Content="&#x25C4;" Width="26" Padding="0" Margin="2,0,0,0" Click="PanLeft_Click"
                            ToolTip="Pan left 1/4 screen"/>
                    <ScrollBar x:Name="HScrollBar" Grid.Column="2" Orientation="Horizontal" Height="18" Margin="6,0"
                               VerticalAlignment="Center" Minimum="0"
                               Maximum="{Binding ScrollMaximum}" ViewportSize="{Binding WindowSpanSeconds}"
                               SmallChange="{Binding ScrollSmallChange}" LargeChange="{Binding ScrollLargeChange}"
                               Value="{Binding WindowStartSeconds, Mode=OneWay}" Scroll="HScrollBar_Scroll"/>
                    <Button Grid.Column="3" Content="&#x25BA;" Width="26" Padding="0" Margin="0,0,2,0" Click="PanRight_Click"
                            ToolTip="Pan right 1/4 screen"/>
                    <Button Grid.Column="4" Content="&#x25BA;&#x25BA;" Width="32" Padding="0" Click="PanFarRight_Click"
                            ToolTip="Pan right 3/4 screen"/>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
