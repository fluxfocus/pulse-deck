<Window x:Class="PulseDeck.App.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markup Text" Height="150" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#1B1D21">
    <!-- Colors set explicitly/locally throughout — relying on the app-wide implicit Window style
         silently failed for this kind of secondary dialog (see RenameSignalDialog for the full story). -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="Label:" Margin="0,0,0,6" Foreground="#9AA0A8"/>
        <TextBox x:Name="InputBox" Grid.Row="1" Height="26" VerticalContentAlignment="Center"
                 Background="#17181B" Foreground="#E3E5E8" BorderBrush="#4FC3F7" CaretBrush="#E3E5E8"
                 KeyDown="InputBox_KeyDown"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"
                    Background="#202227" Foreground="#E3E5E8" BorderBrush="#33363D"/>
            <Button Content="OK" Width="80" Click="Ok_Click" IsDefault="True"
                    Background="#202227" Foreground="#E3E5E8" BorderBrush="#33363D"/>
        </StackPanel>
    </Grid>
</Window>
