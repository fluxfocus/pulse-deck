{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pulse Deck (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/PulseDeck.App/bin/Debug/net10.0-windows/PulseDeck.App.exe",
            "args": [],
            "cwd": "${workspaceFolder}/src/PulseDeck.App",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Pulse Deck (Debug, open a VCD file)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/PulseDeck.App/bin/Debug/net10.0-windows/PulseDeck.App.exe",
            "args": ["${input:vcdFilePath}"],
            "cwd": "${workspaceFolder}/src/PulseDeck.App",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ],
    "inputs": [
        {
            "id": "vcdFilePath",
            "type": "promptString",
            "description": "Full path to a .vcd file to load on startup"
        }
    ]
}
